rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIREBASE SECURITY RULES DOCUMENTATION
     *
     * Core Philosophy: 
     * This ruleset implements a strict user-ownership model combined with a public-read 
     * educational content system. Private user data is sandboxed, while collaborative 
     * features like friend requests use a shared-access model.
     *
     * Data Structure:
     * - /users/{userId}: Root for all private user data (progress, badges, attempts).
     * - /courses, /achievements, /badges: Global, read-only content collections.
     * - /friendRequests: Flat collection for peer-to-peer interactions.
     *
     * Key Security Decisions:
     * 1. Ownership Isolation: All documents under /users/{userId} are strictly owned by 
     *    the authenticated user matching the {userId} wildcard.
     * 2. Content Integrity: Learning content (courses, levels, games) is globally 
     *    readable by signed-in users but is strictly read-only to prevent unauthorized 
     *    modifications to the curriculum.
     * 3. Collaborative Access: Friend requests allow access to only the two involved parties 
     *    (sender and receiver) via denormalized ID fields.
     * 4. Prototyping Flexibility: Rules prioritize authorization (who can access) over 
     *    strict data validation (schema shapes), allowing for rapid frontend iteration.
     *
     * Denormalization for Authorization:
     * - userId/senderId/receiverId are stored directly on documents to avoid costly get() 
     *   lookups and allow for efficient, atomic security checks.
     */

    // --- Helper Functions ---

    /** @description Checks if the user is authenticated. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user is the owner of the path-based userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is involved in a shared document (e.g., friend request). */
    function isParticipant(senderId, receiverId) {
      return isSignedIn() && (request.auth.uid == senderId || request.auth.uid == receiverId);
    }

    /** @description Validates that critical relational fields are not changed during updates. */
    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     * @allow (create) if request.auth.uid == userId
     * @deny (update) if request.auth.uid != userId
     * @principle Path-based ownership and self-creation.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && isUnchanged('id');
      allow delete: if isOwner(userId);

      /**
       * @description Records of user attempts on games.
       * @path /users/{userId}/gameAttempts/{gameAttemptId}
       * @allow (create) if auth user is path owner and data.userId matches.
       * @deny (list) if user tries to list another user's attempts.
       * @principle Subcollection ownership validation.
       */
      match /gameAttempts/{gameAttemptId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isUnchanged('userId');
        allow delete: if isOwner(userId);
      }

      /**
       * @description Earned achievements. Read-only for users; system-managed.
       * @path /users/{userId}/achievements/{userAchievementId}
       */
      match /achievements/{userAchievementId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false; 
      }

      /**
       * @description Earned badges. Read-only for users.
       * @path /users/{userId}/badges/{userBadgeId}
       */
      match /badges/{userBadgeId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }

      /**
       * @description Earned certificates. Read-only for users.
       * @path /users/{userId}/certificates/{certificateId}
       */
      match /certificates/{certificateId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if false;
      }

      /**
       * @description Tracks course progress.
       * @path /users/{userId}/courseProgress/{userCourseProgressId}
       */
      match /courseProgress/{userCourseProgressId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isUnchanged('userId');
        allow delete: if isOwner(userId);
      }
    }

    /**
     * @description Global educational content. Publicly readable by all students.
     * @path /courses/{courseId}
     * @principle Public read with locked-down writes.
     */
    match /courses/{courseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false; // Admin only - managed via Admin SDK/Console

      match /levels/{levelId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false;

        match /games/{gameId} {
          allow get, list: if isSignedIn();
          allow create, update, delete: if false;

          match /hints/{hintId} {
            allow get, list: if isSignedIn();
            allow create, update, delete: if false;
          }
        }
      }
    }

    /**
     * @description Global definitions for Achievements.
     * @path /achievements/{achievementId}
     */
    match /achievements/{achievementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Global definitions for Badges.
     * @path /badges/{badgeId}
     */
    match /badges/{badgeId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Friend requests between users.
     * @path /friendRequests/{friendRequestId}
     * @allow (create) if senderId matches auth UID.
     * @allow (get) if auth user is sender or receiver.
     * @principle Shared access model for collaborative entities.
     */
    match /friendRequests/{friendRequestId} {
      allow get: if isParticipant(resource.data.senderId, resource.data.receiverId);
      allow list: if isSignedIn(); // Queries must be filtered by senderId or receiverId to succeed.
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isParticipant(resource.data.senderId, resource.data.receiverId) && isUnchanged('senderId') && isUnchanged('receiverId');
      allow delete: if isParticipant(resource.data.senderId, resource.data.receiverId);
    }
  }
}