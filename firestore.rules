
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Users can create their own user document, and can only read/update/delete their own.
      allow read, update, delete: if isOwner(userId);
      allow create: if request.auth.uid == userId;
    }
    
    match /userProfiles/{userId} {
      // Users can manage their own profile.
      allow read, write: if isOwner(userId);

      // Certificates are a sub-collection of a user's profile
      match /certificates/{certificateId} {
        allow read, write: if isOwner(userId);
      }

      // XP history is a sub-collection of a user's profile
      match /xpHistory/{xpEntryId} {
        allow read, list: if isOwner(userId);
        // Users can only create their own xp entries. Updates and deletes are disallowed to prevent tampering.
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Publicly readable course content
    match /courses/{courseId} {
      allow get, list: if true;
      // Course content should be managed through a backend/admin interface, not by clients.
      allow create, update, delete: if false; 

      match /levels/{levelId} {
        allow get, list: if true;
        allow create, update, delete: if false;

        match /games/{gameId} {
          allow get, list: if true;
          allow create, update, delete: if false;
        }
      }
    }
  }
}
