
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the Game of Gyan platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "username": {
          "type": "string",
          "description": "User's username for the platform."
        }
      },
      "required": [
        "id",
        "email",
        "username"
      ]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Stores user profile information, learning progress, and game history.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user profile, same as user ID."
        },
        "level": {
          "type": "number",
          "description": "Current level of the user."
        },
        "xp": {
          "type": "number",
          "description": "Total XP points of the user."
        },
        "badges": {
          "type": "array",
          "description": "Array of badges earned by the user.",
          "items": {
            "type": "string"
          }
        },
        "skillLevel": {
          "type": "string",
          "description": "User's skill level (beginner/intermediate/advanced)."
        },
        "streak": {
          "type": "number",
          "description": "Current learning streak of the user."
        },
        "completedCourses": {
          "type": "array",
          "description": "Array of course IDs that the user has completed.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "level",
        "xp",
        "badges",
        "skillLevel",
        "streak",
        "completedCourses"
      ]
    },
    "Course": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Course",
      "type": "object",
      "description": "Represents a coding course available on the platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the course."
        },
        "name": {
          "type": "string",
          "description": "Name of the course."
        },
        "description": {
          "type": "string",
          "description": "Description of the course content."
        },
        "language": {
          "type": "string",
          "description": "Programming language taught in the course (e.g., Python, Java)."
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "language"
      ]
    },
    "Level": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Level",
      "type": "object",
      "description": "Represents a level within a coding course.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the level."
        },
        "courseId": {
          "type": "string",
          "description": "Reference to Course."
        },
        "levelNumber": {
          "type": "number",
          "description": "The number of the level within the course."
        }
      },
      "required": [
        "id",
        "courseId",
        "levelNumber"
      ]
    },
    "Game": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Game",
      "type": "object",
      "description": "Represents a game within a level.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the game."
        },
        "levelId": {
          "type": "string",
          "description": "Reference to Level."
        },
        "type": {
          "type": "string",
          "description": "Type of game (e.g., MCQ, fill-in-the-blank, drag-and-drop)."
        },
        "content": {
          "type": "string",
          "description": "The actual data/content of the game, likely serialized as JSON."
        }
      },
      "required": [
        "id",
        "levelId",
        "type",
        "content"
      ]
    },
    "Certificate": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Certificate",
      "type": "object",
      "description": "Represents a certificate earned by a user upon completing a course.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the certificate."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "courseId": {
          "type": "string",
          "description": "Reference to Course."
        },
        "completionDate": {
          "type": "string",
          "description": "Date when the course was completed.",
          "format": "date-time"
        },
        "certificateURL": {
          "type": "string",
          "description": "URL where the certificate can be downloaded.",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "userId",
        "courseId",
        "completionDate",
        "certificateURL"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user authentication and account information."
    },
    "/userProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile information, learning progress, and game history."
    },
    "/courses/{courseId}": {
      "schema": {
        "$ref": "#/entities/Course"
      },
      "description": "Stores information about available coding courses."
    },
    "/courses/{courseId}/levels/{levelId}": {
      "schema": {
        "$ref": "#/entities/Level"
      },
      "description": "Stores details about levels within a course."
    },
    "/courses/{courseId}/levels/{levelId}/games/{gameId}": {
      "schema": {
        "$ref": "#/entities/Game"
      },
      "description": "Stores information about individual games within a level."
    },
    "/userProfiles/{userId}/certificates/{certificateId}": {
      "schema": {
        "$ref": "#/entities/Certificate"
      },
      "description": "Stores certificates earned by users upon course completion."
    }
  }
}
